# macOS / editor cruft
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Build and packaging artifacts
build/
dist/
site/
.eggs/
*.egg
*.egg-info/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# Logs and runtime files
*.log
*.out
*.pid
*.pid.lock

# Local environment and secrets
.env
.env.*
*.env
*.local
*.secret
*.secrets
*.pem
*.key
*.crt
*.p12
*.pfx
*.der
secrets.*
credentials*.json
service-account*.json

# Streamlit local config and state
.streamlit/secrets.toml

# IDE settings
.idea/
.vscode/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Test and coverage outputs
.coverage
.coverage.*
coverage.xml
htmlcov/

# Dependency lock files created locally for alternate tooling
Pipfile.lock
poetry.lock

# Keep common source and docs tracked by default
!.gitignore
!README.md
!requirements.txt
!*.py
